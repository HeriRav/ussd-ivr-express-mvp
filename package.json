{
  "name": "ussd-ivr-express-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "MVP USSD and IVR webhooks built with Express and TypeScript",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/ussd-ivr.integration.test.cjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}